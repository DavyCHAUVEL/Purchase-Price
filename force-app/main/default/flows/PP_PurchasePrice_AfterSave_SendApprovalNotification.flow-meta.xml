    <recordLookups>
        <description>Recupere toutes les quotations client liees au Purchase Price courant (Purchase_Price__c sur Customer_s_Purchase_Quotation__c).</description>
        <name>Get_Customer_Quotations_For_Purchase_Price</name>
        <label>Get Customer Quotations For Purchase Price</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Customer_Quotations</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Purchase_Price__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Customer_s_Purchase_Quotation__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Name</queriedFields>
        <queriedFields>Customer__c</queriedFields>
        <queriedFields>Customer_Account_Name__c</queriedFields>
        <sortField>Name</sortField>
        <sortOrder>Asc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <description>Recupere la derniere instance d&apos;approbation approuvee du record.</description>
        <name>Get_Latest_Approved_ProcessInstance</name>
        <label>Get Latest Approved ProcessInstance</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
