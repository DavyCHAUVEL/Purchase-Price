    <description>Objectif: envoyer les notifications d&apos;approbation Purchase Price. Standard et customer-specific: un email recapitulatif unique a Robin, avec detail clients et commentaire approbateur. Declenchement: transition To Confirm vers Validate ou Future Price. Expediteur: defaut Salesforce (sandbox QA — remettre OWD ice.sf-noreply avant prod).</description>
    <environments>Default</environments>
    <formulas>
        <description>Segment a ajouter pour la quotation courante dans la boucle (separateur ; si deja du texte).</description>
        <name>fxAppendCurrentQuotationSegment</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!varQuotationLines}),
&quot;• &quot;,
&quot;&lt;br/&gt;• &quot;
) &amp; IF(
ISBLANK({!Loop_Customer_Quotations.Customer_Account_Name__c}),
&quot;Compte client (nom indisponible)&quot;,
{!Loop_Customer_Quotations.Customer_Account_Name__c}
) &amp; &quot; [&quot; &amp; {!Loop_Customer_Quotations.Name} &amp; &quot;]&quot;</expression>
    </formulas>
    <formulas>
        <description>Commentaire saisi par l&apos;approbateur sur la derniere etape approuvee.</description>
        <name>fxApprovedComment</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!Get_Latest_Approved_Step.Comments}),
&quot;&lt;i&gt;(Aucun commentaire approbateur saisi.)&lt;/i&gt;&quot;,
{!Get_Latest_Approved_Step.Comments}
)</expression>
    </formulas>
    <formulas>
        <description>Texte affichable de l&apos;article (sans formule HYPERLINK : le champ Article_Name__c ne doit pas etre intercale tel quel dans un email riche).</description>
        <name>fxArticlePlain</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK($Record.Article__c),
&quot;-&quot;,
IF(
ISBLANK($Record.Article__r.Product__r.Name),
&quot;-&quot;,
$Record.Article__r.Product__r.Name &amp; &quot; (&quot; &amp; IF(OR(ISBLANK($Record.Article__r.Package_Size__c), $Record.Article__r.Package_Size__c &gt;= 1), TEXT($Record.Article__r.Package_Size__c), &quot;0&quot; &amp; TEXT($Record.Article__r.Package_Size__c)) &amp; &quot; KG)&quot;
)
)</expression>
    </formulas>
    <formulas>
        <description>Assemble les 2 parties HTML du tableau recapitulatif standard.</description>
        <name>fxBodyDetail</name>
        <dataType>String</dataType>
        <expression>{!fxBodyTable1} &amp; {!fxBodyTable2}</expression>
    </formulas>
    <formulas>
        <description>Corps email standard pour une creation approuvee.</description>
        <name>fxBodyNew</name>
        <dataType>String</dataType>
        <expression>{!$Label.LB_Purchase_Price_Email_Body_New}
&amp; &quot;&lt;br/&gt;&lt;br/&gt;&quot;
&amp; {!fxBodyDetail}</expression>
    </formulas>
    <formulas>
        <description>HTML part 1/2 (limite longueur formule 3900 char).</description>
        <name>fxBodyTable1</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;table style=&apos;border-collapse:collapse;font-size:14px;max-width:640px;&apos;&gt;&lt;colgroup&gt;&lt;col style=&apos;width:220px&apos;/&gt;&lt;col/&gt;&lt;/colgroup&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Nom du prix d&apos;achat :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&lt;a href=&apos;&quot; &amp; fxRecordUrl &amp; &quot;&apos;&gt;&quot; &amp; $Record.Name &amp; &quot;&lt;/a&gt;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Article :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; fxArticlePlain &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Prix fabricant :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK($Record.Manufacturer_Price__c), &quot;-&quot;, TEXT($Record.Manufacturer_Price__c)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Produit d&apos;achat :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; fxPurchaseThrew &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Marge fournisseur (%) :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK($Record.Supplier_Margin__c), &quot;-&quot;, TEXT($Record.Supplier_Margin__c)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Prix d&apos;achat :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK($Record.Purchase_Price__c), &quot;-&quot;, $Record.Purchase_Price_Formatted__c) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Devise :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK(TEXT($Record.CurrencyIsoCode)), &quot;-&quot;, TEXT($Record.CurrencyIsoCode)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;MOQ min :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK($Record.Min_MOQ__c), &quot;-&quot;, TEXT($Record.Min_MOQ__c)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;MOQ max :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK($Record.Max_MOQ__c), &quot;-&quot;, TEXT($Record.Max_MOQ__c)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;</expression>
    </formulas>
    <formulas>
        <description>HTML part 2/2 (Type de prix / clients, dates, statut, fin tableau).</description>
        <name>fxBodyTable2</name>
        <dataType>String</dataType>
        <expression>&quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Incoterm (prix d&apos;achat) :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK(TEXT($Record.Purchase_Price_Incoterm__c)), &quot;-&quot;, TEXT($Record.Purchase_Price_Incoterm__c)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Fournisseur :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK($Record.Supplier__c), &quot;-&quot;, $Record.Supplier__r.Name) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Type de prix :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; fxEmail_TypePrix &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Client(s) concerné(s) :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; fxEmail_ClientsConcernes &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Début de validité :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK($Record.Start_Validity_Date__c), &quot;-&quot;, TEXT($Record.Start_Validity_Date__c)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Fin de validité :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; IF(ISBLANK($Record.End_Validity_Date__c), &quot;-&quot;, TEXT($Record.End_Validity_Date__c)) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Statut :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; TEXT($Record.Status__c) &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;tr&gt;&lt;td style=&apos;font-weight:bold;vertical-align:top;padding:4px 16px 4px 0;&apos;&gt;Commentaire approbateur :&lt;/td&gt;&lt;td style=&apos;vertical-align:top;padding:4px 0;&apos;&gt;&quot; &amp; fxApprovedComment &amp; &quot;&lt;/td&gt;&lt;/tr&gt;&quot;
&amp; &quot;&lt;/table&gt;&quot;</expression>
    </formulas>
    <formulas>
        <description>Corps email standard pour une mise a jour approuvee.</description>
        <name>fxBodyUpdate</name>
        <dataType>String</dataType>
        <expression>{!$Label.LB_Purchase_Price_Email_Body_Update}
&amp; &quot;&lt;br/&gt;&lt;br/&gt;&quot;
&amp; {!fxBodyDetail}</expression>
    </formulas>
    <formulas>
        <description>Liste des comptes clients (noms + code quotation) pour un prix spécifique ; tiret si standard.</description>
        <name>fxEmail_ClientsConcernes</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!varQuotationLines}),
&quot;-&quot;,
{!varQuotationLines}
)</expression>
    </formulas>
    <formulas>
        <description>Ligne courriel : standard vs customer-specific (pilotage par record type technique).</description>
        <name>fxEmail_TypePrix</name>
        <dataType>String</dataType>
        <expression>IF(
$Record.PP_Is_Customer_Specific_Type__c,
&quot;Customer-Specific Price&quot;,
&quot;Standard Price&quot;
)</expression>
    </formulas>
    <formulas>
        <description>Detecte une revision approuvee (To Confirm -&gt; Validate/Future Price avec PP_Revises renseigne).</description>
        <name>fxIsImportantUpdate</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISNEW()),
ISCHANGED($Record.Status__c),
OR(
TEXT($Record.Status__c) = &quot;Validate&quot;,
TEXT($Record.Status__c) = &quot;Future Price&quot;
),
TEXT($Record__Prior.Status__c) = &quot;To Confirm&quot;,
NOT(ISBLANK($Record.PP_Revises__c))
)</expression>
    </formulas>
    <formulas>
        <description>Detecte une creation approuvee (To Confirm -&gt; Validate/Future Price sans PP_Revises).</description>
        <name>fxIsNewRecord</name>
        <dataType>Boolean</dataType>
        <expression>AND(
NOT(ISNEW()),
ISCHANGED($Record.Status__c),
OR(
TEXT($Record.Status__c) = &quot;Validate&quot;,
TEXT($Record.Status__c) = &quot;Future Price&quot;
),
TEXT($Record__Prior.Status__c) = &quot;To Confirm&quot;,
ISBLANK($Record.PP_Revises__c)
)</expression>
    </formulas>
    <formulas>
        <description>Vrai si aucune quotation client n&apos;est liee au record approuve.</description>
        <name>fxIsStandardNoQuotations</name>
        <dataType>Boolean</dataType>
        <expression>ISBLANK({!varQuotationLines})</expression>
    </formulas>
    <formulas>
        <description>Destinataires notification Purchase Price (Robin ou DL metier), configurable via label.</description>
        <name>fxNotificationRecipients</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK({!$Label.LB_Purchase_Price_Notification_Recipients}),
&quot;robin@iwasecosfa.com&quot;,
{!$Label.LB_Purchase_Price_Notification_Recipients}
)</expression>
    </formulas>
    <formulas>
        <name>fxPurchaseThrew</name>
        <dataType>String</dataType>
        <expression>IF(
ISBLANK($Record.Article__r.Product__r.Name),
&quot;-&quot;,
$Record.Article__r.Product__r.Name
)</expression>
    </formulas>
    <formulas>
        <description>Construit l&apos;URL absolue du Purchase Price pour les emails.</description>
        <name>fxRecordUrl</name>
        <dataType>String</dataType>
        <expression>LEFT($Api.Partner_Server_URL_650, FIND(&quot;/services&quot;, $Api.Partner_Server_URL_650) - 1) &amp; &quot;/&quot; &amp; $Record.Id</expression>
    </formulas>
    <formulas>
        <description>Vrai pour premier passage a Validate (nouveau) ou revision (mise a jour approuvee).</description>
        <name>fxShouldSendApprovalEmail</name>
        <dataType>Boolean</dataType>
        <expression>OR(
{!fxIsNewRecord},
{!fxIsImportantUpdate}
)</expression>
    </formulas>
    <formulas>
        <description>Objet email standard pour creation approuvee.</description>
        <name>fxSubjectNew</name>
        <dataType>String</dataType>
        <expression>$Label.LB_Purchase_Price_Email_Subject &amp; &quot; - Nouveau - &quot; &amp; $Record.Name</expression>
    </formulas>
    <formulas>
        <description>Objet email standard pour update approuvee.</description>
        <name>fxSubjectUpdate</name>
        <dataType>String</dataType>
        <expression>$Label.LB_Purchase_Price_Email_Subject &amp; &quot; - Mise à jour approuvée - &quot; &amp; $Record.Name</expression>
    </formulas>
    <interviewLabel>PP_PurchasePrice_AfterSave_SendApprovalNotification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>PP_PurchasePrice_AfterSave_SendApprovalNotification</label>
    <loops>
